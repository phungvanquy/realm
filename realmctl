#!/usr/bin/env bash
# Manage the Realm service and a flat rule directory. Realm reads configuration;
# this script never sources configuration files or evaluates editor commands.
set -euo pipefail
umask 077

config_dir=/etc/realm/conf.d
service=realm.service
# Override only when using another systemd unit search directory (or mocks).
unit_dir=${REALMCTL_UNIT_DIR:-/etc/systemd/system}
work_dir=
service_work_dir=
unit_transaction=
runtime_transaction=
managed_binary=
state_dir=
rule_path=
rule_state=
service_marker='# Managed by realmctl. Use realmctl setup to update this file.'

usage() {
  cat <<'EOF'
Manage the Realm service and named relay rules on Linux.

Usage: realmctl [--config-dir DIR] [--service NAME] COMMAND [arguments]

Commands:
  setup [--import FILE] [--binary PATH] [--adopt] [--no-enable]
                              Initialize rules, install the service, and enable it at boot
  init [--import FILE]         Initialize configuration; optionally copy an existing config
  add NAME --listen IP:PORT --remote HOST:PORT [--protocol tcp|udp|both] [--disabled]
  list                        List rule names and their configured state
  show NAME                   Print a rule's configuration
  edit NAME                   Edit a temporary copy using VISUAL, EDITOR, or nano
  enable NAME                 Enable a rule on the next service start
  disable NAME                Disable a rule on the next service start
  remove NAME                 Back up and remove a rule
  config show / edit          Inspect or edit shared logging, DNS, and network settings
  check [--binary PATH]        Validate configuration without restarting the service
  recover                     Recover an interrupted apply operation
  apply                       Restart the service, or stop it if all rules are disabled
  start / stop / restart      Control the running service
  service enable / disable    Enable or disable automatic startup at boot
  service show                Show the effective systemd unit and overrides
  service remove              Stop, disable, and remove files created by setup
  status                      Show systemd service status
  logs [--follow]              Show the last 50 journal entries; optionally follow

Options (before COMMAND):
  --config-dir DIR             Absolute configuration directory (default: /etc/realm/conf.d)
  --service NAME              systemd service (default: realm.service)
  -h, --help                  Show this help

Quick start: sudo realmctl setup
            sudo realmctl add web --listen 0.0.0.0:5000 --remote 192.168.1.100:443
            sudo realmctl apply

setup keeps existing rules and does not start or restart the service. Use --adopt
to manage an existing service, or --import FILE to migrate its configuration.
init remains available for configuration-only use. Rules use NAME.toml or
NAME.toml.disabled. IPv6 addresses must be bracketed. File changes take effect on
the next service start; apply/restart interrupt existing connections.
apply validates configuration and verifies listener ownership. Failed restarts
restore the last configuration verified by start/apply, when one is available.
Requires a matching Realm binary with the native check command for service setup
and apply. Listener checks do not test destination reachability.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1."
}

cleanup() {
  local result=$?
  trap - EXIT INT TERM
  set +e
  if [[ -n "$unit_transaction" && -d "$unit_transaction" ]]; then
    restore_unit_transaction || { printf 'Service recovery is pending in %s; retry the command to recover.\n' "$unit_transaction" >&2; result=1; }
  fi
  if [[ -n "$runtime_transaction" ]]; then
    recover_runtime_transaction || { printf 'Apply recovery is pending. Run realmctl recover with the same options.\n' >&2; result=1; }
  fi
  if [[ -n "$work_dir" ]]; then
    rm -rf -- "$work_dir"
  fi
  if [[ -n "$service_work_dir" ]]; then
    rm -rf -- "$service_work_dir"
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

valid_name() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$ ]]
}

require_name() {
  valid_name "$1" || die 'Rule names must start with a letter or digit and contain at most 64 letters, digits, dots, underscores, or hyphens.'
}

require_regular_file() {
  [[ -f "$1" && ! -L "$1" ]] || die "Expected a regular file, not a symlink: $1"
}

# Lock the directory inode: readers need no writable lock file, and every
# realmctl writer (including apply and the editor session) uses the same lock.
open_config() {
  local mode="$1"
  [[ -d "$config_dir" && ! -L "$config_dir" ]] || die "Configuration directory is missing or is a symlink: $config_dir. Run realmctl init first."
  need_command flock
  exec 9<"$config_dir"
  flock --nonblock "$mode" 9 || die "Another realmctl command is using $config_dir. Try again when it finishes."
  if [[ "${2:-}" != recovery ]]; then
    if [[ "$mode" == --exclusive ]]; then reject_pending_apply; fi
    [[ ! -e "$config_dir/.realmctl-init" ]] || die 'Initialization was interrupted. Run init or setup again to finish it.'
    check_layout
  fi
}

reject_pending_apply() {
  local pending
  for pending in "$config_dir"/.realmctl-state/*/transaction; do
    [[ ! -e "$pending" && ! -L "$pending" ]] || die 'An apply operation needs recovery. Run realmctl recover with the same config directory and service before changing rules.'
  done
}

private_directory() {
  [[ ! -L "$1" ]] || die "Private directory must not be a symlink: $1"
  mkdir -p -- "$1"
  chmod 0700 -- "$1"
}

service_hash() {
  local digest
  digest="$(printf '%s' "$service" | sha256sum)" || die 'Could not compute service identity.'
  printf '%s' "${digest%% *}"
}

check_layout() {
  local path name
  for path in "$config_dir"/*; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ ! -L "$path" && ! -d "$path" ]] || die "Use a flat configuration directory without symlinks: $path"
    case "$path" in
      "$config_dir/_global.toml") require_regular_file "$path" ;;
      *.toml|*.toml.disabled)
        require_regular_file "$path"
        name="${path##*/}"
        name="${name%.disabled}"
        name="${name%.toml}"
        require_name "$name"
        [[ ! -e "$config_dir/$name.toml" || ! -e "$config_dir/$name.toml.disabled" ]] ||
          die "Rule $name has both enabled and disabled files; resolve the duplicate first."
        ;;
      *.json) die "realmctl manages TOML filenames only. Import this config with init --import into a new directory: $path" ;;
    esac
  done
}

require_initialized() {
  require_regular_file "$config_dir/_global.toml"
}

new_work_dir() {
  work_dir="$(mktemp -d "$config_dir/.realmctl-work.XXXXXX")"
}

resolve_rule() {
  local name="$1"
  if [[ -e "$config_dir/$name.toml" ]]; then
    rule_path="$config_dir/$name.toml"
    rule_state=enabled
  elif [[ -e "$config_dir/$name.toml.disabled" ]]; then
    rule_path="$config_dir/$name.toml.disabled"
    rule_state=disabled
  else
    die "Rule does not exist: $name"
  fi
  require_regular_file "$rule_path"
}

backup_rule() {
  local path="$1" backup_dir="$config_dir/.realmctl-backups" backup
  [[ ! -L "$backup_dir" ]] || die "Backup directory must not be a symlink: $backup_dir"
  mkdir -p -- "$backup_dir"
  chmod 0700 -- "$backup_dir"
  backup="$(mktemp "$backup_dir/${path##*/}.$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")"
  cp -- "$path" "$backup"
  printf 'Backup: %s\n' "$backup"
}

print_invocation() {
  printf 'realmctl'
  if [[ "$config_dir" != /etc/realm/conf.d ]]; then printf ' --config-dir %q' "$config_dir"; fi
  if [[ "$service" != realm.service ]]; then printf ' --service %q' "$service"; fi
  printf ' %s' "$1"
}

changed() {
  printf '%s Run ' "$1"
  print_invocation apply
  printf ' when ready.\n'
}

# Validate address forms generated by add. The native check command handles
# complete configurations, including edited files and duplicate listeners.
valid_ipv4() {
  local value="$1" octet
  local -a octets
  [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$value"
  for octet in "${octets[@]}"; do
    [[ "$octet" == 0 || "$octet" != 0* ]] || return 1
    ((10#$octet <= 255)) || return 1
  done
}

valid_ipv6() {
  local value="$1" half part tail compressed=false count=0
  local -a halves parts
  [[ "$value" =~ ^[0-9a-fA-F:.]+$ ]] || return 1
  if [[ "$value" == *.* ]]; then
    tail="${value##*:}"
    valid_ipv4 "$tail" || return 1
    value="${value%:*}:0:0"
  fi
  if [[ "$value" == *::* ]]; then
    compressed=true
    halves=("${value%%::*}" "${value#*::}")
  else
    halves=("$value")
  fi
  for half in "${halves[@]}"; do
    [[ -n "$half" ]] || continue
    [[ "$half" != :* && "$half" != *: ]] || return 1
    IFS=: read -r -a parts <<< "$half"
    for part in "${parts[@]}"; do
      [[ "$part" =~ ^[0-9a-fA-F]{1,4}$ ]] || return 1
      count=$((count + 1))
    done
  done
  if [[ "$compressed" == true ]]; then
    ((count < 8))
  else
    ((count == 8))
  fi
}

valid_hostname() {
  local value="${1%.}" label
  local -a labels
  [[ -n "$value" && ${#value} -le 253 && "$value" != *[!a-zA-Z0-9.-]* && "$value" != *[.] && "$value" != .* ]] || return 1
  # Numeric dotted addresses must pass the stricter IPv4 check.
  [[ "$value" == *[!0-9.]* ]] || return 1
  IFS=. read -r -a labels <<< "$value"
  for label in "${labels[@]}"; do
    [[ "$label" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || return 1
  done
}

validate_address() {
  local kind="$1" value="$2" host port
  if [[ "$value" =~ ^\[([^]]+)\]:([0-9]{1,5})$ ]]; then
    host="${BASH_REMATCH[1]}" port="${BASH_REMATCH[2]}"
    valid_ipv6 "$host" || die "Invalid IPv6 $kind address: $value"
  elif [[ "$value" =~ ^([^:]+):([0-9]{1,5})$ ]]; then
    host="${BASH_REMATCH[1]}" port="${BASH_REMATCH[2]}"
    if ! valid_ipv4 "$host"; then
      if [[ "$kind" != remote ]] || ! valid_hostname "$host"; then
        die "Invalid $kind address: $value"
      fi
    fi
  else
    die "Use IP:PORT for listen and HOST:PORT for remote, with brackets around IPv6: $value"
  fi
  ((10#$port >= 1 && 10#$port <= 65535)) || die "Port must be between 1 and 65535: $value"
}

cmd_init() {
  local source='' path
  if [[ $# -gt 0 ]]; then
    [[ $# -eq 2 && "$1" == --import ]] || die 'Usage: realmctl init [--import FILE]'
    source="$2"
    require_regular_file "$source"
    [[ -s "$source" ]] || die "Cannot import an empty configuration: $source"
  fi
  [[ ! -L "$config_dir" ]] || die "Configuration directory must not be a symlink: $config_dir"
  (umask 022; mkdir -p -- "$config_dir")
  open_config --exclusive recovery
  reject_pending_apply
  check_layout
  if [[ -e "$config_dir/.realmctl-init" || -L "$config_dir/.realmctl-init" ]]; then
    new_work_dir
    finish_initialization
  fi
  if [[ -e "$config_dir/_global.toml" ]]; then
    if [[ -n "$source" ]]; then
      cmp -s -- "$source" "$config_dir/imported.toml" || cmp -s -- "$source" "$config_dir/imported.toml.disabled" ||
        die 'Import requires a new configuration directory, or the same unchanged previous import.'
    fi
    printf 'Already initialized: %s\n' "$config_dir"
    return
  fi
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled; do
    [[ ! -e "$path" ]] || die 'Initialize an empty directory; use init --import FILE to copy an existing configuration.'
  done
  new_work_dir
  mkdir -- "$work_dir/init"
  printf 'endpoints = []\n' > "$work_dir/init/_global.toml"
  if [[ -n "$source" ]]; then
    cp --preserve=mode,ownership -- "$source" "$work_dir/init/imported.toml"
  else
    printf '\n[log]\nlevel = "info"\noutput = "stdout"\n' >> "$work_dir/init/_global.toml"
  fi
  chmod 0644 -- "$work_dir/init/_global.toml"
  printf '%s\n' "${work_dir##*/}" > "$work_dir/init/work"
  # Publish a complete recovery record before either visible file. A retry can
  # finish these exact copies even after SIGKILL, without overwriting user data.
  mv -T -- "$work_dir/init" "$config_dir/.realmctl-init"
  finish_initialization
  printf 'Initialized %s. Use ' "$config_dir"
  print_invocation setup
  printf ' to configure the service.\n'
  if [[ -n "$source" ]]; then
    printf 'Copied the existing configuration into the rule imported; the source is unchanged.\n'
  fi
}

finish_initialization() {
  local journal="$config_dir/.realmctl-init" file path staged
  [[ -d "$journal" && ! -L "$journal" ]] || die "Invalid initialization recovery directory: $journal"
  require_regular_file "$journal/_global.toml"
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled; do
    [[ ! -e "$path" || "$path" == "$config_dir/_global.toml" || "$path" == "$config_dir/imported.toml" ]] ||
      die 'Initialization recovery found additional rules; its saved copies were kept for manual recovery.'
  done
  for file in imported.toml _global.toml; do
    [[ -e "$journal/$file" ]] || continue
    require_regular_file "$journal/$file"
    if [[ -e "$config_dir/$file" || -L "$config_dir/$file" ]]; then
      require_regular_file "$config_dir/$file"
      cmp -s -- "$journal/$file" "$config_dir/$file" || die "Initialization recovery would overwrite a changed file: $file. Saved copies: $journal"
    else
      cp --preserve=mode,ownership -- "$journal/$file" "$work_dir/initialize-$file"
      mv -T -- "$work_dir/initialize-$file" "$config_dir/$file"
    fi
  done
  require_regular_file "$journal/work"
  IFS= read -r staged < "$journal/work"
  [[ "$staged" =~ ^\.realmctl-work\.[a-zA-Z0-9]{6}$ && ! -L "$config_dir/$staged" ]] || die 'Invalid initialization staging directory.'
  # Detach the recovery record atomically before recursive cleanup. A killed
  # cleanup must not leave a partially deleted record at the recovery path.
  rm -rf -- "${config_dir:?}/${staged:?}"
  mv -T -- "$journal" "$config_dir/$staged"
  rm -rf -- "${config_dir:?}/${staged:?}"
}

cmd_add() {
  [[ $# -ge 1 ]] || die 'Usage: realmctl add NAME --listen IP:PORT --remote HOST:PORT [--protocol tcp|udp|both] [--disabled]'
  local name="$1" listen='' remote='' protocol='' disabled=false target no_tcp=false use_udp=false
  require_name "$name"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --listen|--remote|--protocol)
        [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
        case "$1" in
          --listen) [[ -z "$listen" ]] || die 'Duplicate --listen option.'; listen="$2" ;;
          --remote) [[ -z "$remote" ]] || die 'Duplicate --remote option.'; remote="$2" ;;
          --protocol) [[ -z "$protocol" ]] || die 'Duplicate --protocol option.'; protocol="$2" ;;
        esac
        shift 2
        ;;
      --disabled) [[ "$disabled" == false ]] || die 'Duplicate --disabled option.'; disabled=true; shift ;;
      *) die "Unknown add option: $1" ;;
    esac
  done
  [[ -n "$listen" && -n "$remote" ]] || die 'Both --listen and --remote are required.'
  validate_address listen "$listen"
  validate_address remote "$remote"
  case "${protocol:-tcp}" in
    tcp) ;;
    udp) no_tcp=true; use_udp=true ;;
    both) use_udp=true ;;
    *) die 'Protocol must be tcp, udp, or both.' ;;
  esac
  open_config --exclusive
  require_initialized
  [[ ! -e "$config_dir/$name.toml" && ! -e "$config_dir/$name.toml.disabled" ]] || die "Rule already exists: $name"
  target="$config_dir/$name.toml"
  if [[ "$disabled" == true ]]; then target+=.disabled; fi
  new_work_dir
  printf '[[endpoints]]\nlisten = "%s"\nremote = "%s"\n\n[endpoints.network]\nno_tcp = %s\nuse_udp = %s\n' \
    "$listen" "$remote" "$no_tcp" "$use_udp" > "$work_dir/rule.toml"
  chmod 0644 -- "$work_dir/rule.toml"
  mv -T -- "$work_dir/rule.toml" "$target"
  changed "Added $name."
}

cmd_list() {
  [[ $# -eq 0 ]] || die 'Usage: realmctl list'
  open_config --shared
  require_initialized
  local path name state
  printf '%-32s %s\n' NAME STATE
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled; do
    [[ -e "$path" && "$path" != "$config_dir/_global.toml" ]] || continue
    name="${path##*/}"
    state=enabled
    if [[ "$name" == *.disabled ]]; then state=disabled; name="${name%.disabled}"; fi
    printf '%-32s %s\n' "${name%.toml}" "$state"
  done
}

cmd_edit() {
  local name="$1" editor="${VISUAL:-${EDITOR:-nano}}" candidate
  local -a editor_command
  [[ "$editor" != *$'\n'* && "$editor" != *$'\r'* ]] || die 'Editor must be a command on one line.'
  if command -v "$editor" >/dev/null 2>&1; then
    editor_command=("$editor")
  else
    # Support common values such as "code --wait" without eval or shell expansion.
    read -r -a editor_command <<< "$editor"
  fi
  [[ ${#editor_command[@]} -gt 0 ]] || die 'Editor command is empty.'
  need_command "${editor_command[0]}"
  new_work_dir
  candidate="$work_dir/$name.toml"
  cp -- "$rule_path" "$work_dir/original"
  cp -- "$rule_path" "$candidate"
  if ! "${editor_command[@]}" "$candidate" 9<&-; then
    die 'Editor exited unsuccessfully; the original rule is unchanged.'
  fi
  require_regular_file "$candidate"
  [[ -s "$candidate" ]] || die 'The edited rule is empty; the original rule is unchanged.'
  if [[ ! -f "$rule_path" || -L "$rule_path" ]] || ! cmp -s -- "$work_dir/original" "$rule_path"; then
    printf 'The original rule changed outside realmctl. Your edited copy is saved at %s\n' "$candidate" >&2
    work_dir=
    die 'Edit was not applied.'
  fi
  if cmp -s -- "$candidate" "$rule_path"; then
    printf 'No changes to %s.\n' "$name"
    return
  fi
  check_layout
  cp --attributes-only --preserve=mode,ownership -- "$rule_path" "$candidate"
  backup_rule "$rule_path"
  mv -fT -- "$candidate" "$rule_path"
  changed "Saved $name ($rule_state)."
}

cmd_rule() {
  local command="$1" name target
  shift
  [[ $# -eq 1 ]] || die "Usage: realmctl $command NAME"
  name="$1"
  require_name "$name"
  if [[ "$command" == show ]]; then open_config --shared; else open_config --exclusive; fi
  require_initialized
  resolve_rule "$name"
  case "$command" in
    show) cat -- "$rule_path" ;;
    edit) cmd_edit "$name" ;;
    enable|disable)
      if [[ "$rule_state" == "${command}d" ]]; then
        printf '%s is already %s.\n' "$name" "$rule_state"
        return
      fi
      target="$config_dir/$name.toml"
      if [[ "$command" == disable ]]; then target+=.disabled; fi
      mv -T -- "$rule_path" "$target"
      changed "Rule $name is now ${command}d."
      ;;
    remove)
      backup_rule "$rule_path"
      rm -- "$rule_path"
      changed "Removed $name."
      ;;
  esac
}

cmd_config() {
  [[ $# -eq 1 && ( "$1" == show || "$1" == edit ) ]] || die 'Usage: realmctl config show|edit'
  if [[ "$1" == show ]]; then open_config --shared; else open_config --exclusive; fi
  require_initialized
  rule_path="$config_dir/_global.toml"
  rule_state='shared settings'
  if [[ "$1" == show ]]; then cat -- "$rule_path"; else cmd_edit _global; fi
}

# Service operations always acquire the unit-directory lock before the config
# lock. This also serializes setup calls that select different config directories
# for the same service. Rule-only commands acquire just the config lock.
lock_units() {
  need_command flock
  [[ -d "$unit_dir" && ! -L "$unit_dir" ]] || die "Expected a systemd unit directory, not a symlink: $unit_dir"
  exec 8<"$unit_dir"
  flock --nonblock --exclusive 8 || die 'Another realmctl command is changing services. Try again when it finishes.'
  unit_transaction="$unit_dir/.realmctl-transactions/$(service_hash)"
  [[ ! -L "$unit_dir/.realmctl-transactions" && ! -L "$unit_transaction" ]] || die 'Service recovery directories must not be symlinks.'
  if [[ -e "$unit_transaction" ]]; then
    printf 'Recovering an interrupted service update for %s.\n' "$service"
    restore_unit_transaction || die "Could not recover $service. Recovery copies: $unit_transaction"
  fi
}

begin_unit_transaction() {
  local target label
  private_directory "$unit_dir/.realmctl-transactions"
  mkdir -- "$service_work_dir/journal"
  printf '%s\n' "$service" > "$service_work_dir/journal/service"
  printf '%s\n' "${service_work_dir##*/}" > "$service_work_dir/journal/work"
  for target in "$@"; do
    if [[ "$target" == "$unit_dir/$service" ]]; then label=unit; else label=override; fi
    if [[ -e "$target" ]]; then
      cp --preserve=mode,ownership -- "$target" "$service_work_dir/journal/$label.original"
    else
      touch -- "$service_work_dir/journal/$label.absent"
    fi
  done
  mv -T -- "$service_work_dir/journal" "$unit_transaction"
}

commit_unit_transaction() {
  touch -- "$unit_transaction/committed"
  finish_unit_journal
}

finish_unit_journal() {
  local staged
  [[ -f "$unit_transaction/work" && ! -L "$unit_transaction/work" ]] || return 1
  IFS= read -r staged < "$unit_transaction/work" || return 1
  [[ "$staged" =~ ^\.realmctl-work\.[a-zA-Z0-9]{6}$ && ! -L "$unit_dir/$staged" ]] || return 1
  rm -rf -- "${unit_dir:?}/${staged:?}" || return 1
  mv -T -- "$unit_transaction" "$unit_dir/$staged" || return 1
  rm -rf -- "${unit_dir:?}/${staged:?}"
}

restore_unit_transaction() {
  local label target recorded
  [[ -d "$unit_transaction" && ! -L "$unit_transaction" ]] || return 1
  [[ -f "$unit_transaction/service" && ! -L "$unit_transaction/service" ]] || return 1
  IFS= read -r recorded < "$unit_transaction/service" || return 1
  [[ "$recorded" == "$service" ]] || return 1
  if [[ -f "$unit_transaction/committed" ]]; then finish_unit_journal || return 1; return 0; fi
  for label in unit override; do
    target="$unit_dir/$service"
    if [[ "$label" == override ]]; then target="$unit_dir/$service.d/90-realmctl.conf"; fi
    [[ ! -L "$target" && ! -L "$unit_dir/$service.d" ]] || return 1
    if [[ -f "$unit_transaction/$label.original" && ! -L "$unit_transaction/$label.original" ]]; then
      cp --preserve=mode,ownership -- "$unit_transaction/$label.original" "$unit_transaction/restore-$label" || return 1
      mv -fT -- "$unit_transaction/restore-$label" "$target" || return 1
    elif [[ -f "$unit_transaction/$label.absent" ]]; then
      rm -f -- "$target" || return 1
    fi
  done
  systemctl daemon-reload || return 1
  finish_unit_journal || return 1
}

is_managed_unit() {
  local first
  [[ -f "$1" && ! -L "$1" ]] || return 1
  IFS= read -r first < "$1" || return 1
  [[ "$first" == "$service_marker" ]]
}

check_service_target() {
  local path line recorded='' encoded_binary='' expected
  managed_binary=
  expected="$(printf '%s' "$config_dir" | base64 --wrap=0)"
  # An adopted service uses the override; a new service uses the main unit.
  for path in "$unit_dir/$service.d/90-realmctl.conf" "$unit_dir/$service"; do
    is_managed_unit "$path" || continue
    while IFS= read -r line; do
      if [[ "$line" == '# realmctl-config-base64: '* ]]; then
        recorded="${line#\# realmctl-config-base64: }"
      elif [[ "$line" == '# realmctl-binary-base64: '* ]]; then
        encoded_binary="${line#\# realmctl-binary-base64: }"
      fi
    done < "$path"
    if [[ "$recorded" != "$expected" ]]; then
      # Configuration-only checks may use another directory without a service.
      if [[ "${1:-required}" == optional ]]; then return 0; fi
      die "$service is configured for a different directory. Select the matching --config-dir or run setup to change it; use realmctl service show to inspect the service."
    fi
    managed_binary="$(printf '%s' "$encoded_binary" | base64 --decode)" || die 'Invalid service binary metadata; run setup again.'
    return 0
  done
  # Keep supporting services set up manually with earlier realmctl releases.
}

# Quote a literal systemd ExecStart argument. systemd applies its own escaping,
# specifier expansion (%); shell quoting is not sufficient here. ExecStart uses
# the ':' prefix to disable environment expansion for all literal arguments.
unit_argument() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//%/%%}"
  printf '"%s"' "$value"
}

service_header() {
  # Encoding prevents special path characters (including a final backslash)
  # from becoming systemd comment continuations or directives.
  printf '%s\n# realmctl-config-base64: ' "$service_marker"
  printf '%s' "$config_dir" | base64 --wrap=0
  printf '\n'
  printf '# realmctl-binary-base64: '
  printf '%s' "$1" | base64 --wrap=0
  printf '\n'
}

service_command() {
  printf 'ExecStart='
  unit_argument ":$1"
  printf ' -c '
  unit_argument "$config_dir"
  printf '\nUnsetEnvironment=REALM_CONF\n'
}

write_service_unit() {
  service_header "$1"
  cat <<'EOF'
[Unit]
Description=Realm TCP and UDP relay
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
DynamicUser=yes
EOF
  service_command "$1"
  cat <<'EOF'
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
EOF
}

backup_service_file() {
  local path="$1" directory="$unit_dir/.realmctl-backups" backup label=unit
  [[ ! -L "$directory" ]] || die "Backup directory must not be a symlink: $directory"
  mkdir -p -- "$directory"
  chmod 0700 -- "$directory"
  if [[ "$path" != "$unit_dir/$service" ]]; then label=override; fi
  backup="$(mktemp "$directory/realmctl-$(service_hash).$label.$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")"
  cp -- "$path" "$backup"
  printf 'Service backup: %s\n' "$backup"
}

enable_service() {
  local state
  systemctl enable -- "$service" || die 'Enabling the service at boot failed. Service files and rules were kept; retry with realmctl service enable.'
  # enable and is-enabled can both succeed for a static unit without enabling
  # it. Verify the actual state before reporting persistent boot enablement.
  state="$(systemctl is-enabled -- "$service" || true)"
  [[ "$state" == enabled ]] || die "Boot state for $service is ${state:-unknown}. Inspect realmctl service show and its [Install] settings, or use setup --no-enable if another unit controls startup. Service files and rules were kept."
}

require_checker() {
  local version
  [[ "$1" == /* && "$1" != *[[:cntrl:]]* && -f "$1" && -x "$1" ]] || die 'Select an accessible absolute Realm binary path.'
  need_command timeout
  version="$(env -u REALM_CONF timeout 5s "$1" check --version 2>/dev/null)" ||
    die 'This realmctl requires a Realm binary with the native check command. Update both commands from the same build.'
  [[ "$version" == 'Realm-check 1' ]] || die 'Unsupported Realm check API. Update both commands from the same build.'
}

find_binary() {
  managed_binary="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/realm"
  if [[ ! -x "$managed_binary" ]]; then managed_binary="$(type -P realm || true)"; fi
}

verify_effective_service() {
  env -u REALM_CONF timeout 20s "$1" check --config "$config_dir" --service "$service" --binary "$1" --service-only --quiet
}

cmd_check() {
  if [[ $# -eq 0 ]]; then
    check_service_target optional
    if [[ -z "$managed_binary" ]]; then find_binary; fi
  else
    [[ $# -eq 2 && "$1" == --binary ]] || die 'Usage: realmctl check [--binary PATH]'
    managed_binary="$2"
  fi
  require_checker "$managed_binary"
  open_config --shared
  require_initialized
  env -u REALM_CONF timeout 15s "$managed_binary" check --config "$config_dir"
}

cmd_setup() {
  local source='' binary='' adopt=false enable=true argument property value
  local info load_state='' fragment='' canonical='' target override=false
  local existed=false
  while [[ $# -gt 0 ]]; do
    argument="$1"
    case "$argument" in
      --import|--binary)
        [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || die "$argument requires a value."
        if [[ "$argument" == --import ]]; then
          [[ -z "$source" ]] || die 'Duplicate --import option.'
          source="$2"
          adopt=true
        else
          [[ -z "$binary" ]] || die 'Duplicate --binary option.'
          binary="$2"
        fi
        shift 2
        ;;
      --adopt) adopt=true; shift ;;
      --no-enable) enable=false; shift ;;
      *) die "Unknown setup option: $argument" ;;
    esac
  done
  if [[ -n "$source" ]]; then
    require_regular_file "$source"
    [[ -s "$source" ]] || die "Cannot import an empty configuration: $source"
  fi
  if [[ -z "$binary" ]]; then
    binary="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/realm"
    if [[ ! -x "$binary" ]]; then binary="$(type -P realm || true)"; fi
  fi
  [[ "$binary" == /* && "$binary" != *[[:cntrl:]]* && -f "$binary" && -x "$binary" ]] ||
    die 'Cannot find an executable Realm binary. Install Realm first or pass setup --binary /absolute/path/to/realm.'
  [[ "$binary" != *\"* && "$binary" != *\'* && "$binary" != *\\* ]] ||
    die 'systemd executable paths cannot contain quotes or backslashes. Choose another path for the Realm binary.'
  value="$(env -u REALM_CONF "$binary" --version)" || die "Cannot run Realm binary: $binary"
  [[ "$value" == Realm\ [0-9]* ]] || die "The selected binary does not identify itself as Realm: $binary"
  require_checker "$binary"
  need_command systemctl
  lock_units
  [[ -w "$unit_dir" ]] || die "Cannot write to $unit_dir. Run setup with sudo."
  info="$(systemctl show --property=LoadState --property=FragmentPath --property=Id -- "$service")" ||
    die 'Cannot inspect the service. setup requires a running systemd system manager; use init for configuration-only use.'
  while IFS='=' read -r property value; do
    case "$property" in
      LoadState) load_state="$value" ;;
      FragmentPath) fragment="$value" ;;
      Id) canonical="$value" ;;
    esac
  done <<< "$info"
  [[ "$load_state" == loaded || "$load_state" == not-found ]] || die "Cannot configure $service with load state ${load_state:-unknown}. Resolve the systemd error first."
  [[ -z "$canonical" || "$canonical" == "$service" ]] || die "Use the canonical service name --service $canonical instead of its alias."
  target="$unit_dir/$service"
  [[ ! -L "$target" ]] || die "Service unit must not be a symlink: $target"
  [[ ! -L "$unit_dir/$service.d" ]] || die "Service override directory must not be a symlink: $unit_dir/$service.d"
  if [[ -e "$target" ]]; then require_regular_file "$target"; fi
  if is_managed_unit "$unit_dir/$service.d/90-realmctl.conf"; then
    override=true
  elif [[ -n "$fragment" || -e "$target" ]]; then
    if ! is_managed_unit "$target" || [[ -n "$fragment" && "$fragment" != "$target" ]]; then
      [[ "$adopt" == true ]] || die "$service already exists. Use setup --adopt to preserve its unit and add a Realm override, or setup --import FILE to migrate."
      override=true
    fi
  fi
  if [[ "$override" == true ]]; then
    target="$unit_dir/$service.d/90-realmctl.conf"
    [[ ! -L "$target" ]] || die "Service override must not be a symlink: $target"
    if [[ -e "$target" ]]; then
      is_managed_unit "$target" || die "Refusing to replace an override not created by realmctl: $target"
    fi
  elif [[ -e "$unit_dir/$service.d/90-realmctl.conf" || -L "$unit_dir/$service.d/90-realmctl.conf" ]]; then
    die "An unmanaged realmctl override already exists: $unit_dir/$service.d/90-realmctl.conf"
  fi
  if [[ "$override" == true && -z "$source" && ! -e "$config_dir/_global.toml" ]]; then
    die 'The existing service needs a configuration to adopt. Use setup --import FILE, or initialize and add rules before setup --adopt.'
  fi

  # Repeating a failed setup --import is safe when that exact import is already
  # present. Never replace a rule that has been edited since the first import.
  if [[ -n "$source" ]]; then
    cmd_init --import "$source"
  else
    cmd_init
  fi
  env -u REALM_CONF timeout 15s "$binary" check --config "$config_dir" --quiet || die 'Configuration is invalid; the service definition was kept.'
  service_work_dir="$(mktemp -d "$unit_dir/.realmctl-work.XXXXXX")"
  if [[ "$override" == true ]]; then
    {
      service_header "$binary"
      printf '[Service]\nType=exec\nExecStart=\n'
      service_command "$binary"
    } > "$service_work_dir/candidate"
  else
    write_service_unit "$binary" > "$service_work_dir/candidate"
  fi
  chmod 0644 -- "$service_work_dir/candidate"
  if [[ -e "$target" ]]; then
    existed=true
  fi
  begin_unit_transaction "$target"
  if [[ "$existed" == false ]] || ! cmp -s -- "$target" "$service_work_dir/candidate"; then
    if [[ "$existed" == true ]]; then backup_service_file "$target"; fi
    if [[ "$override" == true ]]; then (umask 022; mkdir -p -- "$unit_dir/$service.d"); fi
    mv -fT -- "$service_work_dir/candidate" "$target"
  fi
  systemctl daemon-reload || die 'systemd could not reload the unit; restoring the previous service files. Rules were kept.'
  verify_effective_service "$binary" || die 'The effective service differs from the requested setup; restoring the previous service files. Resolve conflicting overrides shown by service show.'
  commit_unit_transaction
  if [[ "$enable" == true ]]; then
    enable_service
  fi
  printf 'Service ready: %s reads %s.\n' "$service" "$config_dir"
  if [[ "$enable" == true ]]; then printf 'Automatic startup at boot is enabled.\n'; fi
  printf 'Add rules if needed, then run '
  print_invocation apply
  printf '.\n'
}

remove_service() {
  local path
  local -a owned=()
  [[ ! -L "$unit_dir/$service" && ! -L "$unit_dir/$service.d" && ! -L "$unit_dir/$service.d/90-realmctl.conf" ]] ||
    die 'Refusing to remove service files through a symlink.'
  for path in "$unit_dir/$service.d/90-realmctl.conf" "$unit_dir/$service"; do
    if is_managed_unit "$path"; then owned+=("$path"); fi
  done
  [[ ${#owned[@]} -gt 0 ]] || die "No service files owned by realmctl for $service. Existing units were kept."
  service_work_dir="$(mktemp -d "$unit_dir/.realmctl-work.XXXXXX")"
  for path in "${owned[@]}"; do
    backup_service_file "$path"
  done
  begin_unit_transaction "${owned[@]}"
  systemctl disable --now -- "$service" || die "Could not stop and disable $service; its files were kept."
  for path in "${owned[@]}"; do
    rm -- "$path" || die "Could not remove $path; restoring service files."
  done
  systemctl daemon-reload || die 'Could not reload systemd; restoring service files. The service remains stopped and disabled.'
  commit_unit_transaction
  printf 'Removed realmctl service files for %s. Rules, backups, binaries, and other service files were kept.\n' "$service"
}

cmd_service() {
  [[ $# -eq 1 ]] || die 'Usage: realmctl service enable|disable|show|remove'
  case "$1" in enable|disable|show|remove) ;; *) die "Unknown service command: $1" ;; esac
  need_command systemctl
  if [[ "$1" == show ]]; then
    systemctl cat -- "$service"
    return
  fi
  lock_units
  check_service_target
  case "$1" in
    enable) enable_service ;;
    disable) systemctl disable -- "$service" ;;
    remove) remove_service ;;
  esac
}

prepare_state() {
  private_directory "$config_dir/.realmctl-state"
  state_dir="$config_dir/.realmctl-state/$(service_hash)"
  private_directory "$state_dir"
}

read_pointer() {
  local name
  if [[ ! -e "$1" && ! -L "$1" ]]; then printf 'none'; return 0; fi
  require_regular_file "$1"
  IFS= read -r name < "$1" || die "Invalid recovery pointer: $1"
  [[ "$name" =~ ^snapshot\.[a-zA-Z0-9]{6}$ ]] || die "Invalid recovery pointer: $1"
  [[ -d "$state_dir/$name" && ! -L "$state_dir/$name" ]] || die "Snapshot is missing or is a symlink: $name"
  printf '%s' "$name"
}

write_pointer() {
  local pointer="$1" name="$2" temporary
  [[ ! -L "$pointer" ]] || die "Recovery pointer must not be a symlink: $pointer"
  temporary="$(mktemp "$state_dir/.pointer.XXXXXX")"
  printf '%s\n' "$name" > "$temporary"
  mv -fT -- "$temporary" "$pointer"
}

copy_configuration() {
  local destination="$1" path
  mkdir -- "$destination" || return 1
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ -f "$path" && ! -L "$path" ]] || return 1
    cp --preserve=mode,ownership -- "$path" "$destination/${path##*/}" || return 1
  done
}

create_snapshot() {
  local snapshot
  snapshot="$(mktemp -d "$state_dir/snapshot.XXXXXX")" || die 'Could not create a private configuration snapshot.'
  copy_configuration "$snapshot/config" || die 'Could not save the configuration snapshot; the running service was kept.'
  printf '%s\n' "$service" > "$snapshot/service" || die 'Could not record the snapshot service.'
  printf '%s' "${snapshot##*/}"
}

snapshot_matches() {
  local snapshot="$1" path name
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled "$snapshot/config"/*.toml "$snapshot/config"/*.toml.disabled; do
    [[ -e "$path" || -L "$path" ]] || continue
    name="${path##*/}"
    [[ -f "$config_dir/$name" && ! -L "$config_dir/$name" && -f "$snapshot/config/$name" && ! -L "$snapshot/config/$name" ]] || return 1
    cmp -s -- "$config_dir/$name" "$snapshot/config/$name" || return 1
    [[ "$(stat -c '%a:%u:%g' -- "$config_dir/$name")" == "$(stat -c '%a:%u:%g' -- "$snapshot/config/$name")" ]] || return 1
  done
}

has_enabled_rules() {
  local path
  for path in "$config_dir"/*.toml; do
    if [[ -e "$path" && "$path" != "$config_dir/_global.toml" ]]; then return 0; fi
  done
  return 1
}

service_pid() {
  local pid
  pid="$(systemctl show --property=MainPID --value -- "$service")" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$pid"
}

wait_ready() {
  # SECONDS has one-second resolution; give the requested interval a complete
  # final tick rather than occasionally allowing only a fraction of a second.
  local deadline=$((SECONDS + ${REALMCTL_START_TIMEOUT:-10} + 1)) pid last_pid='' successes=0
  : > "$state_dir/readiness-error" || return 1
  while ((SECONDS < deadline)); do
    pid="$(service_pid)" || return 1
    if [[ "$pid" != 0 ]] && systemctl is-active --quiet -- "$service" &&
      env -u REALM_CONF timeout 5s "$managed_binary" check --config "$config_dir" --pid "$pid" --quiet 2>"$state_dir/readiness-error"; then
      if [[ "$pid" == "$last_pid" ]]; then successes=$((successes + 1)); else successes=1; fi
      last_pid="$pid"
      if ((successes >= 2)); then return 0; fi
    else
      successes=0
    fi
    sleep 0.1
  done
  if [[ -s "$state_dir/readiness-error" ]]; then cat -- "$state_dir/readiness-error" >&2; fi
  return 1
}

restore_snapshot() {
  local snapshot="$1" path name recorded
  [[ -d "$snapshot/config" && ! -L "$snapshot/config" && -f "$snapshot/service" && ! -L "$snapshot/service" ]] || return 1
  IFS= read -r recorded < "$snapshot/service" || return 1
  [[ "$recorded" == "$service" ]] || return 1
  env -u REALM_CONF timeout 15s "$managed_binary" check --config "$snapshot/config" --quiet || return 1
  # All pending changes remain in the failed snapshot before any file is
  # restored. Copies replace individual files atomically; the journal survives
  # an interruption so the entire restore can be repeated safely.
  for path in "$config_dir"/*.toml "$config_dir"/*.toml.disabled; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ -f "$path" && ! -L "$path" ]] || return 1
    if [[ ! -e "$snapshot/config/${path##*/}" ]]; then rm -- "$path" || return 1; fi
  done
  for path in "$snapshot/config"/*.toml "$snapshot/config"/*.toml.disabled; do
    [[ -e "$path" || -L "$path" ]] || continue
    [[ -f "$path" && ! -L "$path" ]] || return 1
    name="${path##*/}"
    cp --preserve=mode,ownership -- "$path" "$work_dir/$name" || return 1
    mv -fT -- "$work_dir/$name" "$config_dir/$name" || return 1
  done
}

recover_runtime_transaction() {
  local candidate previous active old_pid current_pid saved last_good
  candidate="$(read_pointer "$state_dir/transaction")" || return 1
  if [[ "$candidate" == none ]]; then runtime_transaction=; return 0; fi
  runtime_transaction="$state_dir/$candidate"
  last_good="$(read_pointer "$state_dir/last-good")" || return 1
  if [[ "$last_good" == "$candidate" ]]; then
    rm -- "$state_dir/transaction" || return 1
    runtime_transaction=
    return 0
  fi
  previous="$(read_pointer "$runtime_transaction/previous")" || return 1
  [[ -f "$runtime_transaction/was-active" && ! -L "$runtime_transaction/was-active" ]] || return 1
  IFS= read -r active < "$runtime_transaction/was-active" || return 1
  [[ "$active" == true || "$active" == false ]] || return 1
  verify_effective_service "$managed_binary" || return 1
  if [[ "$previous" == none ]]; then
    [[ -f "$runtime_transaction/previous-pid" && ! -L "$runtime_transaction/previous-pid" ]] || return 1
    IFS= read -r old_pid < "$runtime_transaction/previous-pid" || return 1
    [[ "$old_pid" =~ ^[0-9]+$ ]] || return 1
    current_pid="$(service_pid)" || return 1
    if [[ "$active" != true || "$current_pid" == 0 || "$current_pid" != "$old_pid" ]]; then
      systemctl stop -- "$service" || return 1
    fi
    printf 'No previously verified snapshot is available. Rules were kept; failed changes are saved at %s/config.\n' "$runtime_transaction" >&2
  else
    systemctl stop -- "$service" || return 1
    if [[ ! -d "$runtime_transaction/failed-current" ]]; then
      saved="$(mktemp -d "$runtime_transaction/.save.XXXXXX")" || return 1
      copy_configuration "$saved/config" || return 1
      mv -T -- "$saved/config" "$runtime_transaction/failed-current" || return 1
      rmdir -- "$saved" || return 1
    fi
    if [[ -z "$work_dir" ]]; then new_work_dir || return 1; fi
    restore_snapshot "$state_dir/$previous" || return 1
    if [[ "$active" == true ]] && has_enabled_rules; then
      systemctl start -- "$service" || return 1
      wait_ready || return 1
    fi
    printf 'Restored the last verified configuration. Rejected changes are saved at %s/config.\n' "$runtime_transaction" >&2
  fi
  rm -- "$state_dir/transaction" || return 1
  runtime_transaction=
}

cmd_recover() {
  [[ $# -eq 0 ]] || die 'Usage: realmctl recover'
  need_command systemctl
  lock_units
  check_service_target
  [[ -n "$managed_binary" ]] || die 'Run setup to register the service binary before recovery.'
  require_checker "$managed_binary"
  open_config --exclusive recovery
  prepare_state
  recover_runtime_transaction || die 'Recovery is incomplete; saved copies were kept. Fix the service problem and run recover again.'
  printf 'Recovery complete for %s.\n' "$service"
}

cmd_runtime() {
  local command="$1" candidate previous pid active=false
  shift
  [[ $# -eq 0 ]] || die "Usage: realmctl $command"
  need_command systemctl
  lock_units
  check_service_target
  if [[ "$command" == stop ]]; then systemctl stop -- "$service"; return; fi
  [[ -n "$managed_binary" ]] || die 'Run realmctl setup (or setup --adopt for an existing service) before applying rules.'
  require_checker "$managed_binary"
  open_config --exclusive recovery
  prepare_state
  if [[ -e "$state_dir/transaction" || -L "$state_dir/transaction" ]]; then
    recover_runtime_transaction || die 'Could not recover the interrupted apply; saved copies were kept. Run recover after fixing the service problem.'
    die 'Recovered an interrupted apply. Review the restored rules before applying again.'
  fi
  reject_pending_apply
  [[ ! -e "$config_dir/.realmctl-init" ]] || die 'Run init or setup again to finish interrupted initialization.'
  check_layout
  require_initialized
  verify_effective_service "$managed_binary" || die 'Service configuration differs from setup; the running service was kept.'
  candidate="$(create_snapshot)"
  env -u REALM_CONF timeout 15s "$managed_binary" check --config "$config_dir" --quiet ||
    die 'Configuration validation failed; the running service was kept. Correct the rules and run check before applying.'
  snapshot_matches "$state_dir/$candidate" || die 'Configuration changed outside realmctl during validation; the running service was kept.'
  pid="$(service_pid)" || die 'Could not inspect the running service.'
  if [[ "$pid" != 0 ]] && systemctl is-active --quiet -- "$service"; then active=true; fi
  if [[ "$command" == start && "$active" == true ]]; then
    # Starting an active service must neither restart it nor certify pending
    # edits as the configuration that the current process actually loaded.
    previous="$(read_pointer "$state_dir/last-good")"
    if [[ "$previous" == none ]] || ! snapshot_matches "$state_dir/$previous"; then
      die 'The service is already running with an unverified or changed configuration. Use apply to load and verify these rules.'
    fi
    wait_ready || die 'The running service is missing expected listeners. Check its logs.'
    printf 'Service already active: %s.\n' "$service"
    return
  fi
  if ! has_enabled_rules && [[ "$command" == start ]]; then die 'No enabled rules. Add or enable a rule before starting the service.'; fi
  previous="$(read_pointer "$state_dir/last-good")"
  if [[ "$previous" != none ]]; then printf '%s\n' "$previous" > "$state_dir/$candidate/previous"; fi
  printf '%s\n' "$active" > "$state_dir/$candidate/was-active"
  printf '%s\n' "$pid" > "$state_dir/$candidate/previous-pid"
  runtime_transaction="$state_dir/$candidate"
  write_pointer "$state_dir/transaction" "$candidate"
  if ! has_enabled_rules; then
    systemctl stop -- "$service" || die "Could not stop $service."
    printf 'No enabled rules; stopped %s.\n' "$service"
  else
    if [[ "$command" == start ]]; then
      systemctl start -- "$service" || die 'Service start failed; recovering the previous configuration.'
    else
      printf 'Restarting %s; existing connections will be interrupted.\n' "$service"
      systemctl restart -- "$service" || die 'Service restart failed; recovering the previous configuration.'
    fi
    wait_ready || die 'Not all expected listeners became ready; recovering the previous configuration.'
    snapshot_matches "$state_dir/$candidate" || die 'Configuration changed outside realmctl during startup; recovering the previous configuration.'
    printf 'Service ready: %s owns all expected TCP/UDP listeners.\n' "$service"
  fi
  write_pointer "$state_dir/last-good" "$candidate"
  rm -- "$state_dir/transaction"
  runtime_transaction=
}

main() {
  local command
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config-dir|--service)
        [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value."
        if [[ "$1" == --config-dir ]]; then config_dir="$2"; else service="$2"; fi
        shift 2
        ;;
      -h|--help) usage; return ;;
      --*) die "Unknown option: $1" ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || { usage; return; }
  command="$1"
  shift
  [[ "$config_dir" == /* && "$config_dir" != *[[:cntrl:]]* ]] || die '--config-dir must be an absolute path without control characters.'
  # A trailing slash must not hide a symlink from the directory checks.
  while [[ "$config_dir" == */ && "$config_dir" != / ]]; do config_dir="${config_dir%/}"; done
  [[ "$config_dir" != / && "$config_dir" != */. && "$config_dir" != */.. && "$config_dir" != */./* && "$config_dir" != */../* ]] || die 'Use a dedicated configuration directory without dot path components.'
  [[ "${config_dir##*/}" != .* ]] || die 'The configuration directory name must not start with a dot; Realm ignores hidden configuration directories.'
  [[ "$service" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.@-]*$ ]] || die 'Invalid systemd service name.'
  if [[ "$service" != *.service ]]; then service+=.service; fi
  [[ ${#service} -le 253 && "$service" != *@.service ]] || die 'Use a service name of at most 253 characters to leave room for its .d directory, with an instance name for template services.'
  [[ "$unit_dir" == /* && "$unit_dir" != *[[:cntrl:]]* ]] || die 'REALMCTL_UNIT_DIR must be an absolute path without control characters.'
  while [[ "$unit_dir" == */ && "$unit_dir" != / ]]; do unit_dir="${unit_dir%/}"; done
  [[ "$unit_dir" != / && "$unit_dir" != */. && "$unit_dir" != */.. && "$unit_dir" != */./* && "$unit_dir" != */../* ]] || die 'Use a dedicated systemd unit directory without dot path components.'
  [[ "${REALMCTL_START_TIMEOUT:-10}" =~ ^([1-9]|[1-5][0-9]|60)$ ]] || die 'REALMCTL_START_TIMEOUT must be an integer from 1 to 60 seconds.'
  case "$command" in
    setup) cmd_setup "$@" ;;
    init) cmd_init "$@" ;;
    add) cmd_add "$@" ;;
    list) cmd_list "$@" ;;
    show|edit|enable|disable|remove) cmd_rule "$command" "$@" ;;
    config) cmd_config "$@" ;;
    check) cmd_check "$@" ;;
    recover) cmd_recover "$@" ;;
    apply|start|stop|restart) cmd_runtime "$command" "$@" ;;
    service) cmd_service "$@" ;;
    status)
      [[ $# -eq 0 ]] || die 'Usage: realmctl status'
      need_command systemctl
      systemctl status --no-pager -- "$service"
      ;;
    logs)
      [[ $# -eq 0 || ( $# -eq 1 && "$1" == --follow ) ]] || die 'Usage: realmctl logs [--follow]'
      need_command journalctl
      journalctl --unit="$service" --lines=50 --no-pager "$@"
      ;;
    *) die "Unknown command: $command. Run realmctl --help for usage." ;;
  esac
}

main "$@"
